# ─────────────────────────────────────────────────────────────
# AI 설정 — 둘 중 하나만 넣으면 됩니다. (둘 다 넣으면 Gemini 사용)
# ─────────────────────────────────────────────────────────────

# [무료] Google Gemini API 키 — https://aistudio.google.com/apikey 에서 Google 계정으로 무료 발급
GEMINI_API_KEY=

# [유료] Anthropic Claude API 키 — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# 사용할 AI를 직접 지정하려면 (gemini | claude). 비워두면 키가 있는 쪽을 자동 선택
# AI_PROVIDER=gemini

# ─────────────────────────────────────────────────────────────
# 서버 설정
# ─────────────────────────────────────────────────────────────
PORT=3000

# ─────────────────────────────────────────────────────────────
# 고급 설정 (보통은 건드리지 않아도 됩니다)
# ─────────────────────────────────────────────────────────────
# Gemini 기본 모델 / 무료 한도 초과·서버 혼잡 시 자동으로 넘어갈 예비 모델 (비우면 예비 모델 사용 안 함)
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# 영상 장면을 이미지로 보고 고를 때 쓰는 모델
# GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# Claude 모델 / 작성 노력 수준 (low | medium | high | xhigh | max)
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=high

# 영상 장면 캡처 프로그램 위치 (비워두면 bin/ 폴더 → 시스템 PATH 순서로 자동 탐색)
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg
